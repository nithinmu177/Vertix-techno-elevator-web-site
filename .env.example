# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Public - Safe to expose in build)
# ==============================================================================
# Your Public Frontend Domain URL (e.g. https://mywebsite.onrender.com or https://mywebsite.github.io)
NEXT_PUBLIC_SITE_URL="https://mywebsite.onrender.com"

# Your Secure Backend API URL (e.g. https://mywebsite-api.onrender.com)
NEXT_PUBLIC_API_URL="https://mywebsite-api.onrender.com"


# ==============================================================================
# 2. BACKEND API ENVIRONMENT VARIABLES (Private - DO NOT expose in git or frontend)
# ==============================================================================
# Production Port assigned automatically by Render Free Web Service
PORT=10000

# PostgreSQL Database connection string (from free Neon.tech, Supabase, or Render Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth / JWT production secret (generate using: openssl rand -base64 32)
AUTH_SECRET="generate-a-long-random-32-byte-secret"
AUTH_TRUST_HOST="true"

# Backend production domain URL
NEXTAUTH_URL="https://mywebsite-api.onrender.com"

# Allowed Frontend Origin for CORS (must match your frontend domain exactly)
FRONTEND_URL="https://mywebsite.onrender.com"

# Optional comma-separated extra origins. Use exact domains only, no wildcard.
CORS_ALLOWED_ORIGINS=""

# Simple API throttling in middleware.
API_RATE_LIMIT_PER_MINUTE=120

# Initial Admin Credentials (for seeding / logging into admin)
ADMIN_EMAIL="admin@vertix.local"
ADMIN_PASSWORD="set-a-strong-password-here"

# Media Storage Provider ("cloudinary", "github", or "local")
STORAGE_PROVIDER="cloudinary"

# Cloudinary Configuration (Free Tier: 25GB Storage & Bandwidth)
# Find these in your Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Optional Alternative: GitHub Raw Storage
GITHUB_TOKEN=""
GITHUB_REPOSITORY="owner/repository"
GITHUB_BRANCH="main"
GITHUB_UPLOAD_PATH="public/uploads"


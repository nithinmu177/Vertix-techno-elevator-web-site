generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  CUSTOMER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaCategory {
  PRODUCT
  PROJECT
  SERVICE
  HERO
  BLOG
  GENERAL
  TECHNOLOGY
  SAFETY
  QUALITY
}

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUOTED
  WON
  CLOSED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model Role {
  id        String   @id @default(cuid())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  accounts      Account[]
  sessions      Session[]
  uploadedMedia Media[]   @relation("UploadedMedia")
  quoteRequests QuoteRequest[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Media {
  id              String          @id @default(cuid())
  filename        String
  originalName    String
  url             String
  type            MediaType
  category        MediaCategory   @default(GENERAL)
  mimeType        String
  size            Int
  altText         String?
  title           String?
  description     String?
  uploadedById    String?
  uploadedBy      User?           @relation("UploadedMedia", fields: [uploadedById], references: [id])
  productMedia    ProductMedia[]
  projectMedia    ProjectMedia[]
  serviceMedia    ServiceMedia[]
  blogPosts       BlogPost[]      @relation("BlogCover")
  testimonials    Testimonial[]   @relation("TestimonialPhoto")
  siteSettings    SiteSetting[]   @relation("SiteSettingMedia")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([type, category])
  @@index([createdAt])
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  shortDescription String
  fullDescription  String
  applications     String[]
  capacity         String?
  speed            String?
  floors           String?
  doorType         String?
  driveType        String?
  safetyFeatures   String[]
  finishes         String[]
  energyEfficiency String?
  specifications   Json?
  status           PublishStatus   @default(DRAFT)
  media            ProductMedia[]
  orderItems       OrderItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([slug])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  role      String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId, role])
  @@index([role])
}

model ProjectCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  projects    Project[]
}

model Project {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  location       String
  categoryId     String?
  category       ProjectCategory? @relation(fields: [categoryId], references: [id])
  description    String
  challenge      String?
  solution       String?
  elevatorType   String
  specifications Json?
  timeline       String?
  results        String?
  completionDate DateTime?
  status         PublishStatus   @default(DRAFT)
  media          ProjectMedia[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([slug])
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  mediaId   String
  role      String
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId, role])
}

model Service {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  benefits    String[]
  process     String[]
  status      PublishStatus  @default(DRAFT)
  media       ServiceMedia[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ServiceMedia {
  id        String  @id @default(cuid())
  serviceId String
  mediaId   String
  role      String
  sortOrder Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([serviceId, mediaId, role])
}

model QuoteRequest {
  id               String      @id @default(cuid())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  name             String
  company          String?
  email            String
  phone            String
  projectType      String
  location         String
  buildingType     String?
  numberOfFloors   Int?
  elevatorType     String?
  requiredCapacity String?
  message          String?
  status           QuoteStatus @default(NEW)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  posts       BlogPost[]
}

model BlogPost {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String
  content     String
  author      String
  categoryId  String?
  category    BlogCategory?  @relation(fields: [categoryId], references: [id])
  coverMediaId String?
  coverMedia   Media?        @relation("BlogCover", fields: [coverMediaId], references: [id])
  status      PublishStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, publishedAt])
}

model FAQ {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String
  sortOrder Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Testimonial {
  id          String        @id @default(cuid())
  customerName String
  company     String?
  designation String?
  photoMediaId String?
  photoMedia   Media?       @relation("TestimonialPhoto", fields: [photoMediaId], references: [id])
  quote       String
  rating      Int           @default(5)
  isDemo      Boolean       @default(true)
  status      PublishStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  status    String      @default("DRAFT")
  total     Decimal     @default(0)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int     @default(1)
  price     Decimal @default(0)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  mediaId     String?
  media       Media?   @relation("SiteSettingMedia", fields: [mediaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
